{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.modelsalt/model-salt",
  "title": "Model Salt",
  "description": "Randomness from outside the model, so one prompt gives different answers that still fit the ask.",
  "version": "1.0.1",
  "repository": {
    "url": "https://github.com/modelsalt/model-salt",
    "source": "github"
  },
  "websiteUrl": "https://modelsalt.com",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@modelsalt/model-salt",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "service",
          "description": "anthropic for Claude, Gemini and Kimi models, openai for GPT models",
          "isRequired": false,
          "default": "anthropic",
          "choices": [
            "anthropic",
            "openai"
          ]
        }
      ]
    }
  ]
}
